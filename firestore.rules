rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── helpers ──
    function isSignedIn() {
      return request.auth != null;
    }

    // لو الـ email في قائمة الـ admins
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'admin@schools-system.com' ||
        request.auth.token.email == 'admin2@schools-system.com'
      );
    }

    // موظفو HR لأي مدرسة
    function isHR() {
      return isSignedIn() && (
        request.auth.token.email.matches('hr@.*-school\\.com') ||
        request.auth.token.email.matches('hr2@.*-school\\.com') ||
        request.auth.token.email.matches('hr@stanford[12]-school\\.com') ||
        request.auth.token.email.matches('hr2@stanford[12]-school\\.com')
      );
    }

    // محاسبو أي مدرسة
    function isAccountant() {
      return isSignedIn() && (
        request.auth.token.email.matches('acc[12]\\..*@.*-school\\.com') ||
        request.auth.token.email.matches('acc[12]\\..*@stanford[12]-school\\.com')
      );
    }

    function isHRorAdmin() { return isHR() || isAdmin(); }
    function isAccOrAdmin() { return isAccountant() || isAdmin(); }
    function isAnyStaff()   { return isHR() || isAccountant() || isAdmin(); }

    // ══════════════════════════════
    // employees — HR يقرأ ويكتب، المحاسب يقرأ بس
    // ══════════════════════════════
    match /employees/{docId} {
      allow read:  if isAnyStaff();
      allow write: if isHRorAdmin();
    }

    // ══════════════════════════════
    // attendance — HR يقرأ ويكتب
    // ══════════════════════════════
    match /attendance/{docId} {
      allow read:  if isAnyStaff();
      allow write: if isHRorAdmin();
    }

    // ══════════════════════════════
    // penalties — HR يقرأ ويكتب
    // ══════════════════════════════
    match /penalties/{docId} {
      allow read:  if isAnyStaff();
      allow write: if isHRorAdmin();
    }

    // ══════════════════════════════
    // rewards — HR يقرأ ويكتب
    // ══════════════════════════════
    match /rewards/{docId} {
      allow read:  if isAnyStaff();
      allow write: if isHRorAdmin();
    }

    // ══════════════════════════════
    // permissions (إذونات) — HR فقط
    // ══════════════════════════════
    match /permissions/{docId} {
      allow read:  if isHRorAdmin();
      allow write: if isHRorAdmin();
    }

    // ══════════════════════════════
    // leaves (إجازات) — HR فقط
    // ══════════════════════════════
    match /leaves/{docId} {
      allow read:  if isHRorAdmin();
      allow write: if isHRorAdmin();
    }

    // ══════════════════════════════
    // باقي collections (محاسبة) — المحاسب والأدمن فقط
    // ══════════════════════════════
    match /transactions/{docId} {
      allow read, write: if isAccOrAdmin();
    }
    match /debts/{docId} {
      allow read, write: if isAccOrAdmin();
    }
    match /expenses/{docId} {
      allow read, write: if isAccOrAdmin();
    }
    match /contractors/{docId} {
      allow read, write: if isAccOrAdmin();
    }
    match /buses/{docId} {
      allow read, write: if isAccOrAdmin();
    }
    match /reports/{docId} {
      allow read, write: if isAccOrAdmin();
    }
    match /party/{docId} {
      allow read, write: if isAccOrAdmin();
    }
    match /photoPackages/{docId} {
      allow read, write: if isAccOrAdmin();
    }

    // أي document تاني — Admin بس
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
