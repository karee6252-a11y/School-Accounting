rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ==============================
    // دالة مساعدة: هل المستخدم مسجّل دخول؟
    // ==============================
    function isAuth() {
      return request.auth != null;
    }

    // ==============================
    // دالة مساعدة: هل البيانات المكتوبة تحتوي على schoolId صحيح؟
    // (لمنع كتابة بيانات بدون schoolId)
    // ==============================
    function hasSchoolId() {
      return request.resource.data.schoolId is string
          && request.resource.data.schoolId.size() > 0;
    }

    // ==============================
    // transactions — تحصيل الطلاب
    // ==============================
    match /transactions/{docId} {
      allow read: if isAuth();
      allow create: if isAuth() && hasSchoolId();
      allow update, delete: if isAuth();
    }

    // ==============================
    // debts — المديونيات
    // ==============================
    match /debts/{docId} {
      allow read: if isAuth();
      allow create: if isAuth() && hasSchoolId();
      allow update, delete: if isAuth();
    }

    // ==============================
    // expenses — بند المصروفات
    // ==============================
    match /expenses/{docId} {
      allow read: if isAuth();
      allow create: if isAuth() && hasSchoolId();
      allow update, delete: if isAuth();
    }

    // ==============================
    // custodians — العهد
    // ==============================
    match /custodians/{schoolId} {
      allow read, write: if isAuth();
    }

    // ==============================
    // busCompanies — شركات الباصات (subcollection)
    // busCompanies/{schoolId}/companies/{companyId}
    // ==============================
    match /busCompanies/{schoolId} {
      allow read, write: if isAuth();
      match /companies/{companyId} {
        allow read, write: if isAuth();
      }
    }

    // ==============================
    // busData — بيانات الباصات القديمة (للتوافق)
    // ==============================
    match /busData/{schoolId} {
      allow read, write: if isAuth();
    }

    // ==============================
    // contractors — الموردون والمقاولون
    // ==============================
    match /contractors_suppliers/{docId} {
      allow read: if isAuth();
      allow create: if isAuth() && hasSchoolId();
      allow update, delete: if isAuth();
    }
    match /contractors_purchases/{docId} {
      allow read: if isAuth();
      allow create: if isAuth() && hasSchoolId();
      allow update, delete: if isAuth();
    }
    match /contractors_contracts/{docId} {
      allow read: if isAuth();
      allow create: if isAuth() && hasSchoolId();
      allow update, delete: if isAuth();
    }

    // ==============================
    // partyAttendees — تسجيل الحفلة
    // القراءة العامة مسموحة (لصفحة ticket.html)
    // ==============================
    match /partyAttendees/{docId} {
      allow read: if true;
      allow create: if isAuth() && hasSchoolId();
      allow update, delete: if isAuth();
    }
  }
}
